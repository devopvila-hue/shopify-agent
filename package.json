{
  "name": "shopify-agent",
  "version": "1.0.0",
  "description": "Online shop with an owner admin panel and an agentic tool API. MCP, REST and OpenAI function definitions over Shopify, in four languages, with VAT and Stripe. No chat, no LLM inside.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "src/index.js",
  "bin": {
    "shopify-agent": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "build": "node scripts/export-catalog.mjs && node scripts/build-site.mjs",
    "build:site": "node scripts/build-site.mjs",
    "export:catalog": "node scripts/export-catalog.mjs"
  },
  "keywords": [
    "shopify",
    "mcp",
    "agent",
    "agentic",
    "tools",
    "graphql",
    "ai",
    "llm"
  ],
  "dependencies": {},
  "devDependencies": {}
}
