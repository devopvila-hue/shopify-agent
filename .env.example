# Copy to .env and fill in. The server reads real environment variables;
# .env is loaded automatically if present.

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# mock    -> fully offline, seeded in-memory store. Great for development,
#            for demos, and for letting an agent explore the tool surface
#            without touching a real store.
# shopify -> live Shopify Admin GraphQL API.
# auto    -> shopify when credentials are present, mock otherwise (default).
SHOPIFY_MODE=auto

# ---------------------------------------------------------------------------
# Store (required for SHOPIFY_MODE=shopify)
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option A - static Admin API access token (shpat_...). Legacy apps only.
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B - client credentials (Dev Dashboard apps, January 2026+).
# The server exchanges them for a short-lived token and refreshes it.
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret

# Admin API version. Latest stable as of 2026-11 is 2026-10.
SHOPIFY_API_VERSION=2026-10

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8788

# Shared secret required on every tool call (MCP and REST).
# Leave empty to disable auth (fine for localhost).
# AGENT_API_KEY=change-me

# Refuse to start in mock mode. Useful in CI/production so nobody
# accidentally talks to a fake store.
# SHOPIFY_REQUIRE_AUTH=true
